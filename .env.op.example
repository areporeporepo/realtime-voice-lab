# Copy to .env.op and edit. Holds secret *references*, never secrets.
# Resolved at launch by `op run --env-file=./.env.op` (see run_web.sh).
#
# Point OPENAI_API_KEY at wherever your key lives in 1Password. The field name
# depends on the item category: PASSWORD items use `password`, API Credential
# items use `credential`.
#
#   op item list | grep -i openai        # find it
#   op read op://Vault/item/field        # confirm the reference resolves
#
OPENAI_API_KEY=op://YourVault/openai/password
REALTIME_MODEL=gpt-realtime-2.1
REALTIME_VOICE=marin
PORT=5050
